{
  "mcpServers": {
    "ChromeDevtools": {
      "command": "chrome-devtools-mcp",
      "args": ["--autoConnect", "--channel=beta"]
    },
    "Context7": {
      "command": "context7-mcp",
      "args": []
    },
    "MemPalace": {
      "command": "python3-mempalace",
      "args": ["-m", "mempalace.mcp_server"]
    },
    "Serena": {
      "command": "serena",
      "args": ["start-mcp-server"]
    },
    "XcodeBuildMCP": {
      "command": "xcodebuildmcp",
      "args": ["mcp"]
    }
  }
}
