{
  "mcpServers": {
    "ChromeDevtools": {
      "command": "chrome-devtools-mcp",
      "args": [
        "--autoConnect",
        "--channel=beta"
      ]
    },
    "Context7": {
      "command": "context7-mcp",
      "args": []
    },
    "MemPalace": {
      "command": "python3-mempalace",
      "args": [
        "-m",
        "mempalace.mcp_server"
      ]
    },
    "Mobbin": {
      "url": "https://api.mobbin.com/mcp"
    },
    "Serena": {
      "command": "serena",
      "args": [
        "start-mcp-server"
      ]
    },
    "T3Code": {
      "command": "t3",
      "args": [
        "acp-mcp-bridge"
      ],
      "env": {
        "T3_ACP_MCP_ENDPOINT": "${T3_ACP_MCP_ENDPOINT}",
        "T3_ACP_MCP_AUTHORIZATION": "${T3_ACP_MCP_AUTHORIZATION}"
      }
    },
    "XcodeBuildMCP": {
      "command": "xcodebuildmcp",
      "args": [
        "mcp"
      ]
    }
  }
}
